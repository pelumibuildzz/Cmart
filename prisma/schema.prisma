generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  phoneNumber  String?
  universityId String
  role         Role         @default(USER)
  discountTier String       @default("NONE")
  totalOrders  Int          @default(0)
  business     Business?
  discounts    Discount[]
  orders       Order[]
  orderGroups  OrderGroup[]
  ratings      Rating[]
}

model Business {
  id            String        @id @default(cuid())
  userId        String        @unique
  name          String
  description   String
  universityId  String
  isVerified    Boolean       @default(false)
  averageRating Float         @default(0)
  totalRatings  Int           @default(0)
  accountNumber String?
  bankName      String?
  imageUrl      String?
  imageFileId   String?
  user          User          @relation(fields: [userId], references: [id])
  orders        Order[]
  products      Product[]
  categories    Category[]    @relation("BusinessToCategory")
  subCategories SubCategory[] @relation("BusinessToSubCategory")
}

model Rating {
  id         String      @id @default(cuid())
  rating     Int
  comment    String?
  createdAt  DateTime    @default(now())
  userId     String
  orderId    String?
  subOrderId String?
  orderGroup OrderGroup? @relation(fields: [orderId], references: [id])
  order      Order?      @relation(fields: [subOrderId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String
  imageUrl      String
  stock         Int
  isAvailable   Boolean        @default(true)
  businessId    String
  basePrice     Float
  finalPrice    Float
  markupPercent Float          @default(0)
  orderItems    OrderItem[]
  business      Business       @relation(fields: [businessId], references: [id])
  images        ProductImage[]
  videos        ProductVideo[]
  categories    Category[]     @relation("CategoryToProduct")
  subCategories SubCategory[]  @relation("ProductToSubCategory")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  fileId    String?
  product   Product @relation(fields: [productId], references: [id])
}

model ProductVideo {
  id           String  @id @default(cuid())
  url          String
  thumbnailUrl String?
  productId    String
  fileId       String?
  product      Product @relation(fields: [productId], references: [id])
}

model OrderGroup {
  id                   String     @id @default(cuid())
  userId               String
  total                Float
  status               String
  paymentId            String?
  createdAt            DateTime   @default(now())
  shippingHall         String
  shippingName         String
  shippingUniversityId String
  orders               Order[]
  shippingUniversity   University @relation(fields: [shippingUniversityId], references: [id])
  user                 User       @relation(fields: [userId], references: [id])
  ratings              Rating[]
}

model Order {
  id                     String      @id @default(cuid())
  userId                 String
  businessId             String
  total                  Float
  status                 String
  paymentId              String?
  createdAt              DateTime    @default(now())
  orderGroupId           String?
  discountId             String?     @unique
  payerAccountName       String?
  paymentReceiptImageUrl String?
  paymentReceiptFileId   String?
  business               Business    @relation(fields: [businessId], references: [id])
  discount               Discount?   @relation(fields: [discountId], references: [id])
  orderGroup             OrderGroup? @relation(fields: [orderGroupId], references: [id])
  user                   User        @relation(fields: [userId], references: [id])
  orderItems             OrderItem[]
  ratings                Rating[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  isCustom      Boolean       @default(false)
  subCategories SubCategory[]
  businesses    Business[]    @relation("BusinessToCategory")
  products      Product[]     @relation("CategoryToProduct")
}

model SubCategory {
  id         String     @id @default(cuid())
  name       String     @unique
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  businesses Business[] @relation("BusinessToSubCategory")
  products   Product[]  @relation("ProductToSubCategory")
}

model University {
  id                  String       @id @default(cuid())
  name                String       @unique
  shippingOrderGroups OrderGroup[]
}

model Discount {
  id         String    @id @default(cuid())
  userId     String
  percentage Float
  isUsed     Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  orderId    String?   @unique
  user       User      @relation(fields: [userId], references: [id])
  order      Order?
}

enum Role {
  USER
  BUSINESS
  ADMIN
}
