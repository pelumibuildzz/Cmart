// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale eas  orderId    String?   @unique // The order where the discount was used
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BUSINESS
  ADMIN
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  universityId String
  role         Role         @default(USER)
  orders       Order[]
  orderGroups  OrderGroup[]
  business     Business?
  ratings      Rating[]
  totalOrders  Int          @default(0)
  discountTier String       @default("NONE") // NONE, BRONZE, SILVER, GOLD
  discounts    Discount[]
}

model Business {
  id            String        @id @default(cuid())
  userId        String        @unique
  name          String
  description   String
  universityId  String
  averageRating Float         @default(0)
  totalRatings  Int           @default(0)
  categories    Category[]
  subCategories SubCategory[]
  products      Product[]
  orders        Order[]
  isVerified    Boolean       @default(false)
  user          User          @relation(fields: [userId], references: [id])
}

model Rating {
  id         String      @id @default(cuid())
  rating     Int // 1-5 stars
  comment    String?
  createdAt  DateTime    @default(now())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  orderId    String? // For overall order ratings
  orderGroup OrderGroup? @relation(fields: [orderId], references: [id])
  subOrderId String? // For business-specific ratings
  order      Order?      @relation(fields: [subOrderId], references: [id])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String
  imageUrl      String
  basePrice     Float // Original price set by business
  markupPercent Float          @default(0)
  finalPrice    Float // Calculated final price after markup
  stock         Int
  isAvailable   Boolean        @default(true)
  businessId    String
  categories    Category[]
  subCategories SubCategory[]
  business      Business       @relation(fields: [businessId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String // URL of the image
  productId String // Foreign key to Product
  product   Product @relation(fields: [productId], references: [id])
}

model OrderGroup {
  id                   String     @id @default(cuid())
  userId               String
  total                Float
  status               String
  paymentId            String?
  createdAt            DateTime   @default(now())
  shippingName         String // Recipient's name for shipping
  shippingHall         String // Hall/building for delivery
  shippingUniversityId String // University ID for delivery
  shippingUniversity   University @relation(fields: [shippingUniversityId], references: [id])
  user                 User       @relation(fields: [userId], references: [id])
  orders               Order[]
  ratings              Rating[]
}

model Order {
  id                     String      @id @default(cuid())
  userId                 String
  businessId             String
  orderGroupId           String?
  total                  Float
  status                 String // UNVERIFIED, PENDING, PACKAGING, DELIVERING, DELIVERED, COMPLETED, CANCELLED
  paymentId              String?
  paymentReceiptImageUrl String?
  payerAccountName       String?
  createdAt              DateTime    @default(now())
  user                   User        @relation(fields: [userId], references: [id])
  business               Business    @relation(fields: [businessId], references: [id])
  orderGroup             OrderGroup? @relation(fields: [orderGroupId], references: [id])
  orderItems             OrderItem[]
  ratings                Rating[]
  discountId             String?     @unique
  discount               Discount?   @relation(fields: [discountId], references: [id])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float // Price at the time of purchase
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  isCustom      Boolean       @default(false)
  businesses    Business[]
  products      Product[]
  subCategories SubCategory[]
}

model SubCategory {
  id         String     @id @default(cuid())
  name       String     @unique
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  businesses Business[]
  products   Product[]
}

model University {
  id                  String       @id @default(cuid())
  name                String       @unique
  shippingOrderGroups OrderGroup[]
}

model Discount {
  id         String    @id @default(cuid())
  userId     String
  percentage Float
  isUsed     Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  orderId    String?   @unique // The order where the discount was used
  order      Order?
  user       User      @relation(fields: [userId], references: [id])
}
